{
  "_comment": [
    "Weapon name groups for BO1 zombies, checked against the stock include_weapon() lists of every BO1 zombies map.",
    "bo1: the weapon's real internal name(s) (several when different maps use different names).",
    "bo1_fallback: look-alikes to hand out when the destination map doesn't have the real thing.",
    "The game picks the first name the destination map actually has; if none exist the player is refunded.",
    "BO1's remakes of Nacht, Verruckt, Shi No Numa and Der Riese use zombie_* names (zombie_thompson etc.).",
    "Only base names go here - upgrade_rules derive the Pack-a-Punched names."
  ],

  "upgrade_rules": {
    "bo1": {
      "exceptions": {"m16_zm": "m16_gl_upgraded_zm", "aug_acog_zm": "aug_acog_mk_upgraded_zm"},
      "no_upgrade": ["kar98k_scoped_zombie", "zombie_type99_rifle", "zombie_doublebarrel_sawed", "zombie_bar_bipod"],
      "rules": [
        {"prefix": "zombie_", "base_suffix": "", "upgraded_suffix": "_upgraded"},
        {"base_suffix": "_zm", "upgraded_suffix": "_upgraded_zm"}
      ]
    }
  },

  "groups": [
    {"id": "m1911",                "bo1": ["m1911_zm"]},
    {"id": "magnum",               "bo1": ["python_zm"],                "bo1_fallback": ["cz75_zm"]},
    {"id": "ray_gun",              "bo1": ["ray_gun_zm"]},
