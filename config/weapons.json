{
  "_comment": [
    "Weapon name translation between games, checked against the stock include_weapon() lists of every WaW and BO1 zombies map.",
    "<game>: the weapon's real internal name(s) in that game (several when different maps use different names).",
    "<game>_fallback: look-alikes to hand out when the destination map doesn't have the real thing.",
    "The game picks the first name the destination map actually has; if none exist the player is refunded.",
    "BO1's remakes of the WaW maps reuse the WaW names (zombie_thompson etc.).",
    "Only base names go here - upgrade_rules derive the Pack-a-Punched names."
  ],

  "upgrade_rules": {
    "waw": {
      "rules": [{"base_suffix": "", "upgraded_suffix": "_upgraded"}]
    },
    "bo1": {
      "exceptions": {"m16_zm": "m16_gl_upgraded_zm", "aug_acog_zm": "aug_acog_mk_upgraded_zm"},
      "no_upgrade": ["kar98k_scoped_zombie", "zombie_type99_rifle", "zombie_doublebarrel_sawed", "zombie_bar_bipod"],
      "rules": [
        {"prefix": "zombie_", "base_suffix": "", "upgraded_suffix": "_upgraded"},
        {"base_suffix": "_zm", "upgraded_suffix": "_upgraded_zm"}
      ]
    }
  },

  "groups": [
