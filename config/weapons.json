{
  "_comment": [
    "Weapon name translation between games.",
    "<game>: the weapon's real internal name(s) in that game (several when different maps use different names).",
    "<game>_fallback: look-alikes to hand out when the destination map doesn't have the real thing.",
    "The game picks the first name the destination map actually has; if none exist the player is refunded.",
    "Only base names go here - upgrade_rules derive the Pack-a-Punched names."
  ],

  "upgrade_rules": {
    "waw": {"base_suffix": "", "upgraded_suffix": "_upgraded"},
    "bo1": {"base_suffix": "_zm", "upgraded_suffix": "_upgraded_zm"}
  },

